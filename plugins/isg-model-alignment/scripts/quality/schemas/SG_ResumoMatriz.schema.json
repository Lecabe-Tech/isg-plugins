{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Qualidade — SG_ResumoMatriz",
  "description": "Propostas pendentes, nunca publicadas",
  "type": "object",
  "properties": {
    "aba": {
      "type": "string",
      "const": "SG_ResumoMatriz"
    },
    "modo": {
      "type": "string",
      "const": "proposta"
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ResumoID": {
            "type": "string"
          },
          "CicloID": {
            "type": "string"
          },
          "UF": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "Ano": {
            "type": "integer"
          },
          "Modelo": {
            "type": "string",
            "enum": [
              "7h",
              "9h"
            ]
          },
          "MinutosAula": {
            "type": [
              "number",
              "null"
            ]
          },
          "Elemento": {
            "type": "string"
          },
          "Serie1": {
            "type": [
              "number",
              "null"
            ]
          },
          "Serie2": {
            "type": [
              "number",
              "null"
            ]
          },
          "Serie3": {
            "type": [
              "number",
              "null"
            ]
          },
          "HorasTotais": {
            "type": [
              "number",
              "null"
            ]
          },
          "AulasTotais": {
            "type": [
              "number",
              "null"
            ]
          },
          "CelulaOrigem": {
            "type": [
              "string",
              "null"
            ]
          },
          "StatusValidacao": {
            "const": "Importado - revisar"
          },
          "Publicado": {
            "const": "Não"
          }
        },
        "required": [
          "ResumoID",
          "CicloID",
          "UF",
          "Ano",
          "Modelo",
          "MinutosAula",
          "Elemento",
          "Serie1",
          "Serie2",
          "Serie3",
          "HorasTotais",
          "AulasTotais",
          "CelulaOrigem",
          "StatusValidacao",
          "Publicado"
        ],
        "additionalProperties": false
      }
    },
    "pendencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "origem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "campo",
          "motivo",
          "origem"
        ],
        "additionalProperties": false
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "arquivo": {
            "type": "string"
          },
          "localizador": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "arquivo",
          "localizador"
        ],
        "additionalProperties": false
      }
    },
    "checagens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "aba",
    "modo",
    "linhas",
    "pendencias",
    "fontes",
    "checagens"
  ],
  "additionalProperties": false
}
