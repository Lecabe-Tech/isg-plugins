{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Qualidade — SG_Avaliacoes",
  "description": "Propostas pendentes, nunca publicadas",
  "type": "object",
  "properties": {
    "aba": {
      "type": "string",
      "const": "SG_Avaliacoes"
    },
    "modo": {
      "type": "string",
      "const": "proposta"
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "RegistroID": {
            "type": "string"
          },
          "CicloID": {
            "type": "string"
          },
          "UF": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "Ano": {
            "type": "integer"
          },
          "Modelo": {
            "type": "string",
            "enum": [
              "7h",
              "9h"
            ]
          },
          "Tipo": {
            "type": "string",
            "enum": [
              "Pedagógica",
              "Gestão"
            ]
          },
          "Codigo": {
            "type": "string"
          },
          "PresencaOriginal": {
            "type": [
              "string",
              "null"
            ]
          },
          "Presenca": {
            "enum": [
              "Sim",
              "Não",
              null
            ]
          },
          "JustificativaEvidencia": {
            "type": [
              "string",
              "null"
            ]
          },
          "Origem": {
            "type": "string"
          },
          "CelulaOrigem": {
            "type": [
              "string",
              "null"
            ]
          },
          "StatusValidacao": {
            "const": "Importado - revisar"
          },
          "Publicado": {
            "const": "Não"
          },
          "Aprovador": {
            "type": "null"
          },
          "DocumentoID": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "RegistroID",
          "CicloID",
          "UF",
          "Ano",
          "Modelo",
          "Tipo",
          "Codigo",
          "PresencaOriginal",
          "Presenca",
          "JustificativaEvidencia",
          "Origem",
          "CelulaOrigem",
          "StatusValidacao",
          "Publicado",
          "Aprovador",
          "DocumentoID"
        ],
        "additionalProperties": false
      }
    },
    "pendencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "origem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "campo",
          "motivo",
          "origem"
        ],
        "additionalProperties": false
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "arquivo": {
            "type": "string"
          },
          "localizador": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "arquivo",
          "localizador"
        ],
        "additionalProperties": false
      }
    },
    "checagens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "aba",
    "modo",
    "linhas",
    "pendencias",
    "fontes",
    "checagens"
  ],
  "additionalProperties": false
}
